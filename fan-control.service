# /etc/systemd/system/fan-control.service
#
# Systemd service for fan-control.sh
# Supports live reload via 'systemctl reload fan-control.service'

[Unit]
Description=Fan control service for Zettlab D6U/D8U
After=sysinit.target multi-user.target

[Service]
Type=simple

# Always run via bash (script relies on bash features)
ExecStart=/bin/bash /usr/local/sbin/fan-control.sh

# Live config reload (SIGHUP -> re-read /etc/fan-control)
ExecReload=/bin/kill -HUP $MAINPID

# Restart automatically on failure
Restart=always
RestartSec=5

# Explicit environment for clarity (script also sets PATH itself)
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
Environment=CONFIG_FILE=/etc/fan-control

# Do not apply hardening that would break hwmon or smartctl
ProtectSystem=no
ProtectHome=no

[Install]
WantedBy=multi-user.target
